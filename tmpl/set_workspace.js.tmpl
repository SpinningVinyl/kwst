const execute = () => {
    debugLog(scriptName + " executing JS_SET_WORKSPACE");

    const ws = findWorkspace({{.WorkspaceId}});
    if (ws) {
        workspace.currentDesktop = ws;
    } else {
        returnError(ERROR_WORKSPACE_NOT_FOUND + {{.WorkspaceId}});
    }

}
