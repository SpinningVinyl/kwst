const execute = () => {
    debugLog(scriptName + " executing JS_GROW_ACTIVE_TILE");

    const w = workspace.activeWindow;
    const t = w.tile;

    if (t === null) {
        returnError(ERROR_WINDOW_NOT_TILED + w.internalId);
        return;
    }
    if (typeof t.layoutDirection === "undefined") {
        returnError(ERROR_WINDOW_QUICK_TILED + w.internalId);
        return;
    }
    const target = growthTarget(t, {{jsString .Direction}});
    if (!target) {
        returnError("Active tile has no internal edge in the requested direction");
        return;
    }
    resizeTileByPercent(target.tile, clientAreaForWindow(w), {{.Delta}} * target.sign, target.edge);
}
