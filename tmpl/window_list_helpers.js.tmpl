const formatWindowRow = (
    window,
    showPids,
    showCaptions,
    idOnly
) => {
    const fields = [
        window.internalId
    ];

    if (!idOnly) {

        fields.push(window.resourceClass);
        fields.push(window.resourceName.length === 0 ? "n/a" : window.resourceName);

        if (showPids) {
            fields.push(window.pid);
        }
        if (showCaptions) {
            fields.push(window.caption);
        }
    }

    return fields.join("\t");
}
