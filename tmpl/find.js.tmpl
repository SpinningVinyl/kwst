const execute = () => {
    debugLog(scriptName + " executing JS_SEARCH");

    const allWindows = filterWindows(workspace.windowList(), {{jsString .OutputName}}, {{.WorkspaceId}});
    if (!allWindows) {
        return;
    }
    const property = {{jsString .WindowProperty}};
    const propertyValue = {{jsString .PropertyValue}} === "true";
    const searchFields = {{if .SearchField}}[{{jsString .SearchField}}]{{else}}["resourceClass", "resourceName", "caption"]{{end}};
    let results = [];
    let regExp;
    try {
        regExp = new RegExp({{jsString .SearchTerm}}, 'i');
    } catch (error) {
        returnError("Invalid regular expression: " + error.message);
    }
    if (regExp) {
        for (let i = 0; i < allWindows.length; i++) {
            let w = allWindows[i];
            if ((!property || w[property] === propertyValue) &&
                searchFields.some(field => w[field].search(regExp) >= 0)) {
                results.push(w);
            }
        }
        for (let i = 0; i < results.length; i++) {
            returnResult(results[i].internalId);
        }
    }

}
